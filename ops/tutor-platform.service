[Unit]
Description=Tutor platform (Next.js)
After=network.target docker.service
Requires=docker.service
[Service]
Type=simple
User=@TUTOR_USER@
Group=@TUTOR_GROUP@
WorkingDirectory=@TUTOR_ROOT@/current
EnvironmentFile=@TUTOR_ROOT@/.env
Environment=NODE_ENV=production
Environment=PORT=13003
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=UPLOAD_DIR=@TUTOR_ROOT@/storage/uploads
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@TUTOR_ROOT@/storage
MemoryMax=600M
CPUQuota=100%
[Install]
WantedBy=multi-user.target
